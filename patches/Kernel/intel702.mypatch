diff --git a/arch/x86/kvm/vmx/vmx.c b/arch/x86/kvm/vmx/vmx.c
index 8b24e6825..0442a2fd8 100644
--- a/arch/x86/kvm/vmx/vmx.c
+++ b/arch/x86/kvm/vmx/vmx.c
@@ -6394,6 +6394,20 @@ static int handle_wrmsr_imm(struct kvm_vcpu *vcpu)
 				     vmx_get_msr_imm_reg(vcpu));
 }
 
+// Recalibrate the guest TSC multiplier on each CPUID VM-exit.
+static int handle_cpuid(struct kvm_vcpu *vcpu)
+{
+	vcpu->total_exit_time += 2100;  // Approximate host cycles per exit.
+	u64 tsc = rdtsc();
+	u64 ratio = mul_u64_u64_div_u64(1ULL << kvm_caps.tsc_scaling_ratio_frac_bits, tsc - vcpu->total_exit_time, tsc);
+	if (ratio > 1ULL << (kvm_caps.tsc_scaling_ratio_frac_bits - 2) && ratio < 1ULL << kvm_caps.tsc_scaling_ratio_frac_bits) {
+		kvm_caps.default_tsc_scaling_ratio = ratio;
+		vcpu->arch.tsc_scaling_ratio = ratio;
+		vmcs_write64(TSC_MULTIPLIER, ratio);
+	}
+	return kvm_emulate_cpuid(vcpu);
+}  // end handle_cpuid
+
 /*
  * The exit handlers return 1 if the exit was handled fully and guest execution
  * may resume.  Otherwise they set the kvm_run parameter to indicate what needs
@@ -6407,7 +6421,8 @@ static int (*kvm_vmx_exit_handlers[])(struct kvm_vcpu *vcpu) = {
 	[EXIT_REASON_IO_INSTRUCTION]          = handle_io,
 	[EXIT_REASON_CR_ACCESS]               = handle_cr,
 	[EXIT_REASON_DR_ACCESS]               = handle_dr,
-	[EXIT_REASON_CPUID]                   = kvm_emulate_cpuid,
+//	Default CPUID handling. Replaced by handle_cpuid above.
+	[EXIT_REASON_CPUID]                   = handle_cpuid,
 	[EXIT_REASON_MSR_READ]                = kvm_emulate_rdmsr,
 	[EXIT_REASON_MSR_WRITE]               = kvm_emulate_wrmsr,
 	[EXIT_REASON_INTERRUPT_WINDOW]        = handle_interrupt_window,
@@ -6415,7 +6430,8 @@ static int (*kvm_vmx_exit_handlers[])(struct kvm_vcpu *vcpu) = {
 	[EXIT_REASON_INVD]		      = kvm_emulate_invd,
 	[EXIT_REASON_INVLPG]		      = handle_invlpg,
 	[EXIT_REASON_RDPMC]                   = kvm_emulate_rdpmc,
-	[EXIT_REASON_VMCALL]                  = kvm_emulate_hypercall,
+//	Default VMCALL handling. Replaced to deliver #UD and hide the hypercall path.
+	[EXIT_REASON_VMCALL]                  = kvm_handle_invalid_op,
 	[EXIT_REASON_VMCLEAR]		      = handle_vmx_instruction,
 	[EXIT_REASON_VMLAUNCH]		      = handle_vmx_instruction,
 	[EXIT_REASON_VMPTRLD]		      = handle_vmx_instruction,
diff --git a/arch/x86/kvm/x86.c b/arch/x86/kvm/x86.c
index fd1c4a36b..fae747ff1 100644
--- a/arch/x86/kvm/x86.c
+++ b/arch/x86/kvm/x86.c
@@ -9236,6 +9236,16 @@ static int kvm_vcpu_do_singlestep(struct kvm_vcpu *vcpu)
 		kvm_run->exit_reason = KVM_EXIT_DEBUG;
 		return 0;
 	}
+    // Deliver a real #DB to the guest on single-step, populating dr6, rip,
+    // and exception state so the guest sees a normal single-step fault.
+    if (KVM_GUESTDBG_SINGLESTEP ) {
+        printk(KERN_ALERT "kvm_vcpu_do_singlestep: KVM_GUESTDBG_SINGLESTEP path\n"); 
+        kvm_run->debug.arch.dr6 = DR6_BS | DR6_ACTIVE_LOW | 1;
+        kvm_run->debug.arch.pc = kvm_get_linear_rip(vcpu);
+        kvm_run->debug.arch.exception = DB_VECTOR;
+        kvm_run->exit_reason = KVM_EXIT_DEBUG;
+        return 0;
+    }
 	kvm_queue_exception_p(vcpu, DB_VECTOR, DR6_BS);
 	return 1;
 }
@@ -10497,6 +10507,10 @@ EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_emulate_hypercall);
 
 static int emulator_fix_hypercall(struct x86_emulate_ctxt *ctxt)
 {
+	// Do not patch the guest hypercall into an emulated form. Leave the
+	// instruction as-is so VMCALL reaches the #UD path.
+	return X86EMUL_UNHANDLEABLE;
+
 	struct kvm_vcpu *vcpu = emul_to_vcpu(ctxt);
 	char instruction[3];
 	unsigned long rip = kvm_rip_read(vcpu);
diff --git a/include/linux/kvm_host.h b/include/linux/kvm_host.h
index 6b76e7a6f..0e3535107 100644
--- a/include/linux/kvm_host.h
+++ b/include/linux/kvm_host.h
@@ -350,6 +350,9 @@ struct kvm_vcpu {
 	unsigned int halt_poll_ns;
 	bool valid_wakeup;
 
+	u64 last_exit_start;  // Host TSC when the current VM-exit began.
+	u64 total_exit_time;  // Accumulated host cycles across VM-exits.
+
 #ifdef CONFIG_HAS_IOMEM
 	int mmio_needed;
 	int mmio_read_completed;
