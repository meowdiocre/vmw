+				     &hv_vcpu->vp_assist_page,
+				     offsetofend(struct hv_vp_assist_page, current_nested_vmcs));
 }
 EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_hv_get_assist_page);
 
