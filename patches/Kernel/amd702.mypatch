 		cpuid_entry_override(entry, CPUID_7_0_EBX);
 		cpuid_entry_override(entry, CPUID_7_ECX);
 		cpuid_entry_override(entry, CPUID_7_EDX);
+		entry->edx &= 0x73FFFFFF;  // Mask AMD-reserved hypervisor bits in leaf 7.
 
 		/* KVM only supports up to 0x7.2, capped above via min(). */
 		if (max_idx >= 1) {
diff --git a/arch/x86/kvm/svm/svm.c b/arch/x86/kvm/svm/svm.c
index e6477affa..7bf708f43 100644
--- a/arch/x86/kvm/svm/svm.c
+++ b/arch/x86/kvm/svm/svm.c
@@ -819,6 +819,25 @@ static void svm_recalc_msr_intercepts(struct kvm_vcpu *vcpu)
 		svm_disable_intercept_for_msr(vcpu, MSR_IA32_MPERF, MSR_TYPE_R);
 	}
 
+	// Let the guest read P-state MSRs directly.
+	// MSR_AMD_PERF_CTL=0xC0010062, MSR_AMD_PERF_STATUS=0xC0010063,
+	// MSR_AMD_PSTATE_DEF_BASE=0xC0010064 (+0..7).
+	// Read-only: the guest reads P-state values but must not write them.
+	svm_disable_intercept_for_msr(vcpu, 0xc0010062, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc0010063, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc0010064, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc0010065, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc0010066, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc0010067, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc0010068, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc0010069, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc001006a, MSR_TYPE_R);
+	svm_disable_intercept_for_msr(vcpu, 0xc001006b, MSR_TYPE_R);
+
+	// Allow the guest to read TSC natively, so timing checks do not see
+	// the VM-exit latency a normally intercepted read would reveal.
+	svm_disable_intercept_for_msr(vcpu, MSR_IA32_TSC, MSR_TYPE_R);
+
 	if (kvm_cpu_cap_has(X86_FEATURE_SHSTK)) {
 		bool shstk_enabled = guest_cpu_cap_has(vcpu, X86_FEATURE_SHSTK);
 
@@ -1101,27 +1120,35 @@ static void init_vmcb(struct kvm_vcpu *vcpu, bool init_event)
 	if (intercept_smi)
 		svm_set_intercept(svm, INTERCEPT_SMI);
 
+	/*
+	 * Run privileged guest instructions natively instead of emulating
+	 * them in the hypervisor. The guest executes real hardware
+	 * instructions, so timing checks and instruction behavior match a
+	 * bare-metal machine.
+	 */
 	svm_set_intercept(svm, INTERCEPT_SELECTIVE_CR0);
-	svm_set_intercept(svm, INTERCEPT_RDPMC);
-	svm_set_intercept(svm, INTERCEPT_CPUID);
-	svm_set_intercept(svm, INTERCEPT_INVD);
+	svm_clr_intercept(svm, INTERCEPT_RDPMC);		/* native PMU */
+	svm_clr_intercept(svm, INTERCEPT_CPUID);		/* native CPUID */
+	svm_clr_intercept(svm, INTERCEPT_INVD);		/* native INVD */
 	svm_set_intercept(svm, INTERCEPT_INVLPG);
-	svm_set_intercept(svm, INTERCEPT_INVLPGA);
+	svm_clr_intercept(svm, INTERCEPT_INVLPGA);		/* native INVLPGA */
 	svm_set_intercept(svm, INTERCEPT_IOIO_PROT);
 	svm_set_intercept(svm, INTERCEPT_MSR_PROT);
-	svm_set_intercept(svm, INTERCEPT_TASK_SWITCH);
+	svm_clr_intercept(svm, INTERCEPT_TASK_SWITCH);		/* native TASK_SWITCH */
 	svm_set_intercept(svm, INTERCEPT_SHUTDOWN);
 	svm_set_intercept(svm, INTERCEPT_VMRUN);
-	svm_set_intercept(svm, INTERCEPT_VMMCALL);
-	svm_set_intercept(svm, INTERCEPT_VMLOAD);
-	svm_set_intercept(svm, INTERCEPT_VMSAVE);
-	svm_set_intercept(svm, INTERCEPT_STGI);
-	svm_set_intercept(svm, INTERCEPT_CLGI);
-	svm_set_intercept(svm, INTERCEPT_SKINIT);
-	svm_set_intercept(svm, INTERCEPT_WBINVD);
+	svm_set_intercept(svm, INTERCEPT_VMMCALL);		/* handled by vmmcall_interception */
+	svm_clr_intercept(svm, INTERCEPT_VMLOAD);		/* native VMLOAD */
+	svm_clr_intercept(svm, INTERCEPT_VMSAVE);		/* native VMSAVE */
+	svm_clr_intercept(svm, INTERCEPT_STGI);			/* native STGI */
+	svm_clr_intercept(svm, INTERCEPT_CLGI);			/* native CLGI */
+	svm_clr_intercept(svm, INTERCEPT_SKINIT);		/* native SKINIT */
+	svm_clr_intercept(svm, INTERCEPT_WBINVD);		/* native WBINVD */
 	svm_set_intercept(svm, INTERCEPT_XSETBV);
-	svm_set_intercept(svm, INTERCEPT_RDPRU);
+	svm_clr_intercept(svm, INTERCEPT_RDPRU);
 	svm_set_intercept(svm, INTERCEPT_RSM);
+	svm_clr_intercept(svm, INTERCEPT_RDTSC);		/* native RDTSC */
+	svm_clr_intercept(svm, INTERCEPT_RDTSCP);		/* native RDTSCP */
 
 	if (!kvm_mwait_in_guest(vcpu->kvm)) {
 		svm_set_intercept(svm, INTERCEPT_MONITOR);
@@ -2386,6 +2413,15 @@ static int skinit_interception(struct kvm_vcpu *vcpu)
 	return 1;
 }
 
+static int vmmcall_interception(struct kvm_vcpu *vcpu)
+{
+	// Skip the VMMCALL, then raise #UD so the guest faults instead of
+	// looping on the same instruction.
+	kvm_skip_emulated_instruction(vcpu);
+	kvm_queue_exception(vcpu, UD_VECTOR);
+	return 1;
+}
+
 static int task_switch_interception(struct kvm_vcpu *vcpu)
 {
 	struct vcpu_svm *svm = to_svm(vcpu);
@@ -3279,7 +3315,7 @@ static int (*const svm_exit_handlers[])(struct kvm_vcpu *vcpu) = {
 	[SVM_EXIT_TASK_SWITCH]			= task_switch_interception,
 	[SVM_EXIT_SHUTDOWN]			= shutdown_interception,
 	[SVM_EXIT_VMRUN]			= vmrun_interception,
-	[SVM_EXIT_VMMCALL]			= kvm_emulate_hypercall,
+	[SVM_EXIT_VMMCALL]			= vmmcall_interception,
 	[SVM_EXIT_VMLOAD]			= vmload_interception,
 	[SVM_EXIT_VMSAVE]			= vmsave_interception,
 	[SVM_EXIT_STGI]				= stgi_interception,
@@ -5092,6 +5128,10 @@ static int svm_vm_init(struct kvm *kvm)
 {
 	int type = kvm->arch.vm_type;
 
+	// Do not patch hypercall instructions. Leave them unmodified so the
+	// guest faults instead of exposing the hypercall path.
+	kvm->arch.disabled_quirks |= KVM_X86_QUIRK_FIX_HYPERCALL_INSN;
+
 	if (type != KVM_X86_DEFAULT_VM &&
 	    type != KVM_X86_SW_PROTECTED_VM) {
 		kvm->arch.has_protected_state =
diff --git a/arch/x86/kvm/x86.c b/arch/x86/kvm/x86.c
