+/*
+ * Present Hyper-V root-partition CPUID values to L2 (nested guest).
+ *
+ * When Windows runs as L2 under Hyper-V (L1) under KVM (L0), the
+ * hypervisor CPUID leaves L2 observes come from Hyper-V's
+ * nested-virtualization layer and identify the machine as a Hyper-V
+ * guest (child partition).  Some software reads these leaves to
+ * learn the partition type.
+ *
+ * KVM cannot answer these probes directly: the Windows kernel and
+ * secure kernel need the values that hvix64 computes.  Fabricated
+ * values break VBS/HVCI init and hang boot.
+ *
+ * Let the exit flow to L1 unchanged.  Record which leaf L2 asked.
+ * When L1 VMRUNs back into L2, rewrite only these bits:
+ *
+ *   0x40000000 vendor      EBX/ECX/EDX -> "Microsoft Hv" (EAX untouched)
+ *   0x40000003 privileges  EBX |= 1 -> CreatePartitions (root partition);
+ *                          the other 96 privilege bits stay real
+ *   0x40000006 nested      EAX bits [13:10] = 0 -> not a nested guest
+ *
+ * Everything else (all other leaves, all L1 CPUID) is untouched.
+ */
+/*
+ * Answer a repeated L2 CPUID from the cache filled with answers L1
+ * (hvix64) produced for the same (leaf, subleaf).  Return true if the
+ * exit was handled (guest RIP advanced past the CPUID); the exit is
+ * then not reflected to L1, which avoids the nested round trip.
+ *
+ * Serve only leaves whose answers are constant for a given vCPU: the
+ * max-leaf/vendor leaf, the extended feature and brand-string leaves,
+ * and the Hyper-V range.  Leaves whose values can change over time
+ * always go to L1: 1, 7, and 0xB/0x1F carry per-vCPU state (OSXSAVE,
+ * APIC, MWAIT, OSPKE, x2APIC ID), 0xD depends on XCR0, the 0x40000100+
+ * Hyper-V leaves depend on L1 state, 0x8000001F depends on SEV.
+ */
+#define VMW_L2_CPUID_FAST_LEAF(l) \
+	((l) == 0 || \
+	 ((l) >= 0x80000000 && (l) <= 0x80000004) || (l) == 0x80000008 || \
+	 ((l) >= 0x40000000 && (l) <= 0x4000000a))
+
+/*
+ * Answer from the host-captured table.  These are the values the
+ * physical CPU itself returns, captured at vCPU creation, so L2 sees
+ * bare-metal feature bits (no hypervisor bit, real brand string, real
+ * topology) with no L1 involvement.  Constant leaves only.
+ */
+static bool svm_vmw_host_cpuid_lookup(struct kvm_vcpu *vcpu, u32 leaf,
+				      u32 subleaf)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	int i;
+
+	if (!svm->nested.vmw_host_cpuid_prefilled)
+		return false;
+
+	for (i = 0; i < VMW_HOST_CPUID_ENTRIES; i++) {
+		if (svm->nested.vmw_host_cpuid[i].leaf != leaf)
+			continue;
+		if (svm->nested.vmw_host_cpuid[i].subleaf_valid &&
+		    svm->nested.vmw_host_cpuid[i].subleaf != subleaf)
+			continue;
+
+		kvm_rax_write(vcpu, svm->nested.vmw_host_cpuid[i].eax);
+		kvm_rbx_write(vcpu, svm->nested.vmw_host_cpuid[i].ebx);
+		kvm_rcx_write(vcpu, svm->nested.vmw_host_cpuid[i].ecx);
+		kvm_rdx_write(vcpu, svm->nested.vmw_host_cpuid[i].edx);
+		return true;
+	}
+
+	return false;
+}
+
+/*
+ * Cache lookup and answer, safe to call with IRQs disabled
+ * (fastpath).  Touches only vcpu->arch.regs; never touches guest
+ * memory.  The caller has already checked the exit code and the leaf
+ * range.
+ */
+static bool svm_vmw_answer_l2_cpuid_core(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	u32 leaf = (u32)vcpu->arch.regs[VCPU_REGS_RAX];
+	u32 subleaf = (u32)vcpu->arch.regs[VCPU_REGS_RCX];
+	int i;
+
+	/* Host-captured values win over the L1-replayed cache. */
+	if (svm_vmw_host_cpuid_lookup(vcpu, leaf, subleaf))
+		return true;
+
+	for (i = 0; i < VMW_L2_CPUID_CACHE_ENTRIES; i++) {
+		if (!svm->nested.vmw_l2_cpuid_cache[i].valid)
+			continue;
+		if (svm->nested.vmw_l2_cpuid_cache[i].leaf != leaf ||
+		    svm->nested.vmw_l2_cpuid_cache[i].subleaf != subleaf)
+			continue;
+
+		kvm_rax_write(vcpu, svm->nested.vmw_l2_cpuid_cache[i].eax);
+		kvm_rbx_write(vcpu, svm->nested.vmw_l2_cpuid_cache[i].ebx);
+		kvm_rcx_write(vcpu, svm->nested.vmw_l2_cpuid_cache[i].ecx);
+		kvm_rdx_write(vcpu, svm->nested.vmw_l2_cpuid_cache[i].edx);
+		return true;
+	}
+
+	return false;
+}
+
+/*
+ * Slow-path variant used from svm_handle_exit(): full checks and RIP
+ * advance via kvm_skip_emulated_instruction().
+ */
+static bool svm_vmw_answer_l2_cpuid_fast(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	u32 leaf = (u32)kvm_rax_read(vcpu);
+
+	if (!vcpu->arch.hyperv_enabled)
+		return false;
+
+	if (svm->vmcb->control.exit_code != SVM_EXIT_CPUID)
+		return false;
+
+	if (!VMW_L2_CPUID_FAST_LEAF(leaf))
+		return false;
+
+	/* Only take over exits that would otherwise be reflected to L1. */
+	if (!vmcb12_is_intercept(&svm->nested.ctl, INTERCEPT_CPUID))
+		return false;
+
+	if (svm_vmw_answer_l2_cpuid_core(vcpu)) {
+		kvm_skip_emulated_instruction(vcpu);
+		return true;
+	}
+
+	return false;
+}
+
+/*
+ * Answer an L1 leaf-0 CPUID (the Windows root partition, where a
+ * usermode timing probe runs) from the host-captured table.  This is
+ * the L1 analogue of the L2 fast path: leaf 0 is vendor + max-leaf,
+ * a constant with no feature bits, so serving the host value keeps
+ * the exit cost near native without exposing any feature bits that
+ * could make the guest poke MSRs it should not (a wider set once sent
+ * Windows into an MSR_VM_IGNNE write loop).  Every other leaf falls
+ * through to full emulation untouched.
+ */
+static bool svm_vmw_answer_l1_cpuid_fast(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	u32 leaf = (u32)vcpu->arch.regs[VCPU_REGS_RAX];
+
+	if (svm->vmcb->control.exit_code != SVM_EXIT_CPUID)
+		return false;
+
+	if (leaf != 0)
+		return false;
+
+	/* Host table only; do not serve the L1-replayed L2 cache here. */
+	if (!svm_vmw_host_cpuid_lookup(vcpu, leaf,
+				       (u32)vcpu->arch.regs[VCPU_REGS_RCX]))
+		return false;
+
+	kvm_skip_emulated_instruction(vcpu);
+	return true;
+}
+
+/*
+ * Fastpath variant, called from svm_exit_handlers_fastpath() with
+ * IRQs disabled.  Answers from the cache and advances RIP with
+ * next_rip, which the caller has already validated to be non-zero.
+ * EXIT_FASTPATH_REENTER_GUEST re-enters L2 directly without the full
+ * exit handling.
+ */
+static fastpath_t svm_vmw_answer_l2_cpuid_fastpath(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	u32 leaf = (u32)vcpu->arch.regs[VCPU_REGS_RAX];
+
+	if (!vcpu->arch.hyperv_enabled)
+		return EXIT_FASTPATH_NONE;
+
+	if (svm->vmcb->control.exit_code != SVM_EXIT_CPUID)
+		return EXIT_FASTPATH_NONE;
+
+	if (!VMW_L2_CPUID_FAST_LEAF(leaf))
+		return EXIT_FASTPATH_NONE;
+
+	/* Only take over exits that would otherwise be reflected to L1. */
+	if (!vmcb12_is_intercept(&svm->nested.ctl, INTERCEPT_CPUID))
+		return EXIT_FASTPATH_NONE;
+
+	if (svm_vmw_answer_l2_cpuid_core(vcpu)) {
+		kvm_rip_write(vcpu, svm->vmcb->control.next_rip);
+		svm->next_rip = 0;
+		kvm_pmu_instruction_retired(vcpu);
+		return EXIT_FASTPATH_REENTER_GUEST;
+	}
+
+	return EXIT_FASTPATH_NONE;
+}
+
+static void svm_vmw_track_l2_cpuid(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+
+	svm->nested.vmw_cpuid_pending = false;
+
+	if (!vcpu->arch.hyperv_enabled)
+		return;
+
+	if (svm->vmcb->control.exit_code != SVM_EXIT_CPUID)
+		return;
+
+	/* Record leaf and RIP so the answer can be patched at L2 re-entry.
+	 * svm_handle_exit() runs after svm_vcpu_run() copied VMCB save.RAX
+	 * into vcpu->arch.regs, so RAX here is the requested leaf. */
+	svm->nested.vmw_cpuid_pending_leaf = kvm_rax_read(vcpu);
+	svm->nested.vmw_cpuid_pending_subleaf = kvm_rcx_read(vcpu);
+	svm->nested.vmw_cpuid_exit_rip = svm->vmcb->save.rip;
+	svm->nested.vmw_cpuid_pending = true;
+}
+
+/*
+ * Called from nested_svm_vmrun() when L1 is about to (re)enter L2.
+ * If L2's last exit was one of the Hyper-V leaves listed above, and
+ * L2 resumes right after that CPUID (rip advanced by 2, the size of
+ * the CPUID instruction), the answer was computed by L1 (hvix64) and
+ * is about to be delivered to L2.  Rewrite only the listed bits.
+ *
+ * Register plumbing (SVM):
+ *  - VMRUN loads RAX/RSP/RIP from vmcb12; kvm_rax_write() path reads
+ *    vmcb12->save.rax, so EAX answers are patched in vmcb12.
+ *  - RBX/RCX/RDX are not loaded from the VMCB; hvix64 sets them as
+ *    live GPRs before VMRUN, and they reach L2 through
+ *    vcpu->arch.regs (loaded/stored by vmenter.S around every
+ *    VMRUN).  Patch those in vcpu->arch.regs.
+ */
+void svm_vmw_patch_l2_cpuid_answer(struct kvm_vcpu *vcpu, struct vmcb *vmcb12)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	u32 leaf = svm->nested.vmw_cpuid_pending_leaf;
+
+	if (!svm->nested.vmw_cpuid_pending)
+		return;
+	svm->nested.vmw_cpuid_pending = false;
+
+	/* L2 must resume exactly after the CPUID instruction. */
+	if (vmcb12->save.rip != svm->nested.vmw_cpuid_exit_rip + 2)
+		return;
+
+	switch (leaf) {
+	case 0x40000000:	/* Hypervisor vendor signature */
+		vcpu->arch.regs[VCPU_REGS_RBX] = 0x7263694d;	/* "Micr" */
+		vcpu->arch.regs[VCPU_REGS_RCX] = 0x666f736f;	/* "osof" */
+		vcpu->arch.regs[VCPU_REGS_RDX] = 0x76482074;	/* "t Hv" */
+		break;
+	case 0x40000003:	/* Partition privileges: claim root */
+		/* Set CreatePartitions (bit 0); keep all real bits.
+		 * Truncate to 32 bits like real CPUID does. */
+		vcpu->arch.regs[VCPU_REGS_RBX] = (u32)vcpu->arch.regs[VCPU_REGS_RBX] | 1;
+		break;
+	case 0x40000006:	/* HW resource assignment: not nested */
+		/* Clear nesting level [13:10]; keep everything else. */
+		vmcb12->save.rax = (u32)vmcb12->save.rax & ~0x3c00ULL;
+		vcpu->arch.regs[VCPU_REGS_RAX] &= ~0x3c00ULL;
+		break;
+	default:
+		break;
+	}
+
+	/*
+	 * Cache the final (patched) answer so future L2 probes of the
+	 * same (leaf, subleaf) can be served directly by L0 without
+	 * the nested round trip.  The subleaf recorded at exit time is
+	 * the key L2 actually requested.  Cache only constant leaves.
+	 */
+	if (VMW_L2_CPUID_FAST_LEAF(leaf)) {
+		u32 subleaf = svm->nested.vmw_cpuid_pending_subleaf;
+		int i, slot = -1;
+
+		for (i = 0; i < VMW_L2_CPUID_CACHE_ENTRIES; i++) {
+			if (svm->nested.vmw_l2_cpuid_cache[i].valid &&
+			    svm->nested.vmw_l2_cpuid_cache[i].leaf == leaf &&
+			    svm->nested.vmw_l2_cpuid_cache[i].subleaf == subleaf) {
+				slot = i;
+				break;
+			}
+			if (slot < 0 && !svm->nested.vmw_l2_cpuid_cache[i].valid)
+				slot = i;
+		}
+
+		if (slot >= 0) {
+			svm->nested.vmw_l2_cpuid_cache[slot].leaf = leaf;
+			svm->nested.vmw_l2_cpuid_cache[slot].subleaf = subleaf;
+			svm->nested.vmw_l2_cpuid_cache[slot].eax =
+				(u32)vmcb12->save.rax;
+			svm->nested.vmw_l2_cpuid_cache[slot].ebx =
+				(u32)vcpu->arch.regs[VCPU_REGS_RBX];
+			svm->nested.vmw_l2_cpuid_cache[slot].ecx =
+				(u32)vcpu->arch.regs[VCPU_REGS_RCX];
+			svm->nested.vmw_l2_cpuid_cache[slot].edx =
+				(u32)vcpu->arch.regs[VCPU_REGS_RDX];
+			svm->nested.vmw_l2_cpuid_cache[slot].valid = true;
+		}
+	}
+}
+
+
 static int svm_handle_exit(struct kvm_vcpu *vcpu, fastpath_t exit_fastpath)
 {
 	struct vcpu_svm *svm = to_svm(vcpu);
@@ -3614,6 +4066,22 @@ static int svm_handle_exit(struct kvm_vcpu *vcpu, fastpath_t exit_fastpath)
 
 		trace_kvm_nested_vmexit(vcpu, KVM_ISA_SVM);
 
