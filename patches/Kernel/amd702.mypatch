 	}
 
 	if (svm_is_vmrun_failure(svm->vmcb->control.exit_code)) {
@@ -4234,8 +4712,17 @@ static fastpath_t svm_exit_handlers_fastpath(struct kvm_vcpu *vcpu)
 	if (!nrips || !control->next_rip)
 		return EXIT_FASTPATH_NONE;
 
-	if (is_guest_mode(vcpu))
+	/*
+	 * Answer repeated L2 CPUID probes from the cache here, in the
+	 * IRQs-off fastpath, so their exit latency stays close to bare
+	 * metal.
+	 */
+	if (is_guest_mode(vcpu)) {
+		fastpath_t fp = svm_vmw_answer_l2_cpuid_fastpath(vcpu);
+		if (fp != EXIT_FASTPATH_NONE)
+			return fp;
 		return EXIT_FASTPATH_NONE;
+	}
 
 	switch (control->exit_code) {
 	case SVM_EXIT_MSR:
@@ -5092,6 +5579,12 @@ static int svm_vm_init(struct kvm *kvm)
 {
 	int type = kvm->arch.vm_type;
 
+	/*
+	 * Do not patch hypercall instructions.  Leave them unmodified so
+	 * the guest faults instead of exposing the hypercall path.
+	 */
+	kvm->arch.disabled_quirks |= KVM_X86_QUIRK_FIX_HYPERCALL_INSN;
+
 	if (type != KVM_X86_DEFAULT_VM &&
 	    type != KVM_X86_SW_PROTECTED_VM) {
 		kvm->arch.has_protected_state =
diff --git a/arch/x86/kvm/svm/svm.h b/arch/x86/kvm/svm/svm.h
index 6942e6b0e..818bf663d 100644
--- a/arch/x86/kvm/svm/svm.h
+++ b/arch/x86/kvm/svm/svm.h
@@ -186,6 +186,7 @@ struct svm_nested_state {
 	struct kvm_vmcb_info vmcb02;
 	u64 hsave_msr;
 	u64 vm_cr_msr;
+	u64 vm_ignne_msr;
 	u64 vmcb12_gpa;
 	u64 last_vmcb12_gpa;
 
@@ -218,6 +219,51 @@ struct svm_nested_state {
 	 * on its side.
 	 */
 	bool force_msr_bitmap_recalc;
+
+	/*
+	 * L2 Hyper-V CPUID patch state.  When L2 exits on CPUID for a
+	 * hypervisor leaf, the leaf and RIP are recorded here; when L1
+	 * VMRUNs back into L2, the answer registers are patched to
+	 * present root-partition values to L2.
+	 */
+	u32 vmw_cpuid_pending_leaf;
+	u32 vmw_cpuid_pending_subleaf;
+	u64 vmw_cpuid_exit_rip;
+	bool vmw_cpuid_pending;
+
+	/*
+	 * Cache of L2 CPUID answers as computed (and patched) by L1.
+	 * Repeated L2 CPUID probes are answered directly by L0 with
+	 * the cached values instead of reflecting the exit to L1,
+	 * which keeps the exit latency close to bare metal.  Every
+	 * answer is one hvix64 itself produced for the same (leaf,
+	 * subleaf); nothing is fabricated.
+	 */
+#define VMW_L2_CPUID_CACHE_ENTRIES 32
+	struct {
+		u32 leaf;
+		u32 subleaf;
+		u32 eax, ebx, ecx, edx;
+		bool valid;
+	} vmw_l2_cpuid_cache[VMW_L2_CPUID_CACHE_ENTRIES];
+
+	/*
+	 * Host-captured CPUID answers used to prefill the L2 direct-return
+	 * cache.  Captured from raw host CPUID at vCPU creation; constant
+	 * leaves only.  The values present the physical CPU to L2 so the
+	 * VBS secure kernel sees bare-metal feature bits (no hypervisor
+	 * bit, no Hyper-V max leaf) without the nested L1 round trip.
+	 * Entries with subleaf_valid set match on (leaf, subleaf); the
+	 * rest match on leaf alone.
+	 */
+#define VMW_HOST_CPUID_ENTRIES 16
+	struct {
+		u32 leaf;
+		u32 subleaf;
+		u32 eax, ebx, ecx, edx;
+		bool subleaf_valid;
+	} vmw_host_cpuid[VMW_HOST_CPUID_ENTRIES];
+	bool vmw_host_cpuid_prefilled;
 };
 
