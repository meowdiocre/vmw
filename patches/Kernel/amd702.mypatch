+/*
+ * Record the physical CPU's CPUID answers for the constant,
+ * per-CPU-uniform leaves L2 may probe.  Only leaves whose answer is
+ * identical for every vCPU and independent of control-register state
+ * belong here: the vendor/max-leaf leaf, the extended feature leaf,
+ * the brand-string leaves, and the address-size leaf.
+ *
+ * Leaves that KVM recomputes per vCPU are excluded on purpose, the
+ * same judgement the L2 fast-leaf list applies to 0xD:
+ *   - leaf 1   OSXSAVE/APIC/MWAIT depend on guest CR4 and MSRs
+ *   - leaf 7   OSPKE depends on guest CR4.PKE
+ *   - leaf 0xB/0x1F  EDX is the per-vCPU x2APIC ID
+ * Those fall through to the per-vCPU L1-replayed cache, which holds
+ * hvix64's correct per-vCPU answers.
+ */
+static void svm_vmw_capture_host_cpuid(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	u32 eax, ebx, ecx, edx;
+	int n = 0;
+
+#define VMW_CAP(l, s, sv)						      \
+	do {								      \
+		cpuid_count((l), (s), &eax, &ebx, &ecx, &edx);		      \
+		svm->nested.vmw_host_cpuid[n].leaf = (l);		      \
+		svm->nested.vmw_host_cpuid[n].subleaf = (s);		      \
+		svm->nested.vmw_host_cpuid[n].subleaf_valid = (sv);	      \
+		svm->nested.vmw_host_cpuid[n].eax = eax;		      \
+		svm->nested.vmw_host_cpuid[n].ebx = ebx;		      \
+		svm->nested.vmw_host_cpuid[n].ecx = ecx;		      \
+		svm->nested.vmw_host_cpuid[n].edx = edx;		      \
+		n++;							      \
+	} while (0)
+
+	VMW_CAP(0x00000000, 0, false);
+	VMW_CAP(0x80000000, 0, false);
+	VMW_CAP(0x80000001, 0, false);
+	VMW_CAP(0x80000002, 0, false);
+	VMW_CAP(0x80000003, 0, false);
+	VMW_CAP(0x80000004, 0, false);
+	VMW_CAP(0x80000008, 0, false);
+#undef VMW_CAP
+}
+
+/*
+ * Seed the L2 direct-return cache with the host-captured answers so
+ * even the first L2 probe of a constant leaf is answered by L0 without
+ * the nested round trip.  Runs at vCPU reset, after the guest CPUID
+ * table exists; safe to repeat, it only writes the cache slots.
+ */
+void svm_vmw_prefill_host_cpuid(struct kvm_vcpu *vcpu)
+{
+	struct vcpu_svm *svm = to_svm(vcpu);
+	int i;
+
+	if (svm->nested.vmw_host_cpuid_prefilled)
+		return;
+
+	for (i = 0; i < VMW_HOST_CPUID_ENTRIES; i++) {
+		if (i >= VMW_L2_CPUID_CACHE_ENTRIES)
+			break;
+		svm->nested.vmw_l2_cpuid_cache[i].leaf =
+			svm->nested.vmw_host_cpuid[i].leaf;
+		svm->nested.vmw_l2_cpuid_cache[i].subleaf =
+			svm->nested.vmw_host_cpuid[i].subleaf;
+		svm->nested.vmw_l2_cpuid_cache[i].eax =
+			svm->nested.vmw_host_cpuid[i].eax;
+		svm->nested.vmw_l2_cpuid_cache[i].ebx =
+			svm->nested.vmw_host_cpuid[i].ebx;
+		svm->nested.vmw_l2_cpuid_cache[i].ecx =
+			svm->nested.vmw_host_cpuid[i].ecx;
+		svm->nested.vmw_l2_cpuid_cache[i].edx =
+			svm->nested.vmw_host_cpuid[i].edx;
+		svm->nested.vmw_l2_cpuid_cache[i].valid = true;
+	}
+
+	svm->nested.vmw_host_cpuid_prefilled = true;
+}
+
