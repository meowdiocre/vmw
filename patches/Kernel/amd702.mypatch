diff --git a/arch/x86/kvm/cpuid.c b/arch/x86/kvm/cpuid.c
index 8137927e7..b4d2d45a7 100644
--- a/arch/x86/kvm/cpuid.c
+++ b/arch/x86/kvm/cpuid.c
@@ -1479,6 +1479,7 @@ static inline int __do_cpuid_func(struct kvm_cpuid_array *array, u32 function)
 		cpuid_entry_override(entry, CPUID_7_0_EBX);
 		cpuid_entry_override(entry, CPUID_7_ECX);
 		cpuid_entry_override(entry, CPUID_7_EDX);
+		entry->edx &= 0x73FFFFFF;  /* DEVIRTZ: mask AMD-reserved hypervisor bits */
 
 		/* KVM only supports up to 0x7.2, capped above via min(). */
 		if (max_idx >= 1) {
diff --git a/arch/x86/kvm/svm/svm.c b/arch/x86/kvm/svm/svm.c
index e6477affa..2fe64a0ad 100644
--- a/arch/x86/kvm/svm/svm.c
+++ b/arch/x86/kvm/svm/svm.c
@@ -819,6 +819,9 @@ static void svm_recalc_msr_intercepts(struct kvm_vcpu *vcpu)
 		svm_disable_intercept_for_msr(vcpu, MSR_IA32_MPERF, MSR_TYPE_R);
 	}
 
+	/* DEVIRTZ: Allow native RDMSR for TSC to hide VMEXIT timing */
+	svm_disable_intercept_for_msr(vcpu, MSR_IA32_TSC, MSR_TYPE_R);
+
 	if (kvm_cpu_cap_has(X86_FEATURE_SHSTK)) {
 		bool shstk_enabled = guest_cpu_cap_has(vcpu, X86_FEATURE_SHSTK);
 
@@ -1122,6 +1125,9 @@ static void init_vmcb(struct kvm_vcpu *vcpu, bool init_event)
 	svm_set_intercept(svm, INTERCEPT_XSETBV);
 	svm_set_intercept(svm, INTERCEPT_RDPRU);
 	svm_set_intercept(svm, INTERCEPT_RSM);
+	svm_clr_intercept(svm, INTERCEPT_RDTSC);	/* DEVIRTZ: native TSC */
+	svm_clr_intercept(svm, INTERCEPT_RDTSCP);	/* DEVIRTZ: native TSCP */
+	svm_clr_intercept(svm, INTERCEPT_CPUID);	/* DEVIRTZ: native CPUID - EDK2 patched to read APIC ID from Local APIC register */
 
 	if (!kvm_mwait_in_guest(vcpu->kvm)) {
 		svm_set_intercept(svm, INTERCEPT_MONITOR);
@@ -2386,6 +2392,13 @@ static int skinit_interception(struct kvm_vcpu *vcpu)
 	return 1;
 }
 
+static int vmmcall_interception(struct kvm_vcpu *vcpu)
+{
+	/* DEVIRTZ: Inject #UD for VMMCALL to hide KVM patching behavior */
+	kvm_queue_exception(vcpu, UD_VECTOR);
+	return 1;
+}
+
 static int task_switch_interception(struct kvm_vcpu *vcpu)
 {
 	struct vcpu_svm *svm = to_svm(vcpu);
@@ -3279,7 +3292,7 @@ static int (*const svm_exit_handlers[])(struct kvm_vcpu *vcpu) = {
 	[SVM_EXIT_TASK_SWITCH]			= task_switch_interception,
 	[SVM_EXIT_SHUTDOWN]			= shutdown_interception,
 	[SVM_EXIT_VMRUN]			= vmrun_interception,
-	[SVM_EXIT_VMMCALL]			= kvm_emulate_hypercall,
+	[SVM_EXIT_VMMCALL]			= vmmcall_interception,
 	[SVM_EXIT_VMLOAD]			= vmload_interception,
 	[SVM_EXIT_VMSAVE]			= vmsave_interception,
 	[SVM_EXIT_STGI]				= stgi_interception,
@@ -4367,11 +4380,28 @@ static __no_kcsan fastpath_t svm_vcpu_run(struct kvm_vcpu *vcpu, u64 run_flags)
 	 * is no need to worry about the conditional branch over the wrmsr
 	 * being speculatively taken.
 	 */
+	/* DEVIRTZ TSC Offset Compensation:
+	 * Before re-entering the guest, calculate how much time we spent
+	 * in the host handling the previous VM-Exit, and subtract it from
+	 * the guest's TSC offset. This "pauses" the guest clock during
+	 * host processing, making VM-Exits invisible to timing analysis.
+	 */
+	if (vcpu->last_exit_start) {
+		u64 host_duration = rdtsc_ordered() - vcpu->last_exit_start;
+		if (host_duration < 10000000) {  /* Sanity cap ~10M cycles */
+			vcpu->arch.tsc_offset -= host_duration;
+			svm_write_tsc_offset(vcpu);
+		}
+	}
+
 	if (!static_cpu_has(X86_FEATURE_V_SPEC_CTRL))
 		x86_spec_ctrl_set_guest(svm->virt_spec_ctrl);
 
 	svm_vcpu_enter_exit(vcpu, spec_ctrl_intercepted);
 
+	/* Start measuring host processing time for this VM-Exit */
+	vcpu->last_exit_start = rdtsc_ordered();
+
 	if (!static_cpu_has(X86_FEATURE_V_SPEC_CTRL))
 		x86_spec_ctrl_restore_host(svm->virt_spec_ctrl);
 
diff --git a/include/linux/kvm_host.h b/include/linux/kvm_host.h
index 8c13426f4..4e11e42f7 100644
--- a/include/linux/kvm_host.h
+++ b/include/linux/kvm_host.h
@@ -351,6 +351,8 @@ struct kvm_vcpu {
 	unsigned int halt_poll_ns;
 	bool valid_wakeup;
 
+	u64 last_exit_start;  /* DEVIRTZ: host processing start timestamp */
+
 #ifdef CONFIG_HAS_IOMEM
 	int mmio_needed;
 	int mmio_read_completed;
