+		 * answers hvix64 produced earlier.  A hit avoids the
+		 * nested exit/reflection/VMRUN round trip; the delivered
+		 * values are exactly what L1 computed for the same leaf.
+		 */
+		if (svm_vmw_answer_l2_cpuid_fast(vcpu))
