 		bool shstk_enabled = guest_cpu_cap_has(vcpu, X86_FEATURE_SHSTK);
 
@@ -1122,6 +1126,9 @@ static void init_vmcb(struct kvm_vcpu *vcpu, bool init_event)
 	svm_set_intercept(svm, INTERCEPT_XSETBV);
 	svm_set_intercept(svm, INTERCEPT_RDPRU);
 	svm_set_intercept(svm, INTERCEPT_RSM);
+	svm_clr_intercept(svm, INTERCEPT_RDTSC);	// Run RDTSC natively.
+	svm_clr_intercept(svm, INTERCEPT_RDTSCP);	// Run RDTSCP natively.
+	svm_clr_intercept(svm, INTERCEPT_CPUID);	// Native CPUID; firmware reads APIC ID from the LAPIC register.
 
 	if (!kvm_mwait_in_guest(vcpu->kvm)) {
 		svm_set_intercept(svm, INTERCEPT_MONITOR);
@@ -2386,6 +2393,14 @@ static int skinit_interception(struct kvm_vcpu *vcpu)
 	return 1;
 }
 
+static int vmmcall_interception(struct kvm_vcpu *vcpu)
+{
+	// Deliver a #UD to the guest on VMMCALL, hiding the hypercall path
+	// from software that probes for KVM patching behavior.
+	kvm_queue_exception(vcpu, UD_VECTOR);
+	return 1;
+}
+
 static int task_switch_interception(struct kvm_vcpu *vcpu)
 {
 	struct vcpu_svm *svm = to_svm(vcpu);
@@ -3279,7 +3294,7 @@ static int (*const svm_exit_handlers[])(struct kvm_vcpu *vcpu) = {
 	[SVM_EXIT_TASK_SWITCH]			= task_switch_interception,
 	[SVM_EXIT_SHUTDOWN]			= shutdown_interception,
 	[SVM_EXIT_VMRUN]			= vmrun_interception,
-	[SVM_EXIT_VMMCALL]			= kvm_emulate_hypercall,
+	[SVM_EXIT_VMMCALL]			= vmmcall_interception,
 	[SVM_EXIT_VMLOAD]			= vmload_interception,
 	[SVM_EXIT_VMSAVE]			= vmsave_interception,
 	[SVM_EXIT_STGI]				= stgi_interception,
@@ -4367,11 +4382,27 @@ static __no_kcsan fastpath_t svm_vcpu_run(struct kvm_vcpu *vcpu, u64 run_flags)
 	 * is no need to worry about the conditional branch over the wrmsr
 	 * being speculatively taken.
 	 */
+	// TSC offset compensation.
+	// Before re-entering the guest, subtract the time spent in the host
+	// handling the previous VM-exit from the guest TSC offset. The guest
+	// clock is effectively paused during host processing, so VM-exits are
+	// invisible to timing analysis.
+	if (vcpu->last_exit_start) {
+		u64 host_duration = rdtsc_ordered() - vcpu->last_exit_start;
+		if (host_duration < 10000000) {  /* Sanity cap ~10M cycles */
+			vcpu->arch.tsc_offset -= host_duration;
+			svm_write_tsc_offset(vcpu);
+		}
+	}
+
 	if (!static_cpu_has(X86_FEATURE_V_SPEC_CTRL))
 		x86_spec_ctrl_set_guest(svm->virt_spec_ctrl);
 
 	svm_vcpu_enter_exit(vcpu, spec_ctrl_intercepted);
 
+	// Record the host TSC at VM-exit to measure host processing time.
+	vcpu->last_exit_start = rdtsc_ordered();
+
 	if (!static_cpu_has(X86_FEATURE_V_SPEC_CTRL))
 		x86_spec_ctrl_restore_host(svm->virt_spec_ctrl);
 
