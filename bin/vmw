#!/usr/bin/env bash

# VMW - VM Workspace CLI entrypoint.
#
# Usage:
#   vmw                        interactive menu
#   vmw plan <profile>         dry-run all modules (print commands)
#   vmw setup <profile>        run the full automated setup
#   vmw deploy <profile>       generate + define the domain XML
#   vmw patch-status           verify patch integrity + target versions
#   vmw patch-check [comp]     clone sources and verify patches apply cleanly
#   vmw status                 show VMs and profile state
#   vmw help                   show this help

set -o pipefail

# Resolve the repo root from this script's real location (handles symlinks).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
VMW_ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
export VMW_ROOT

# shellcheck source=lib/init.sh
. "$VMW_ROOT/lib/init.sh"

usage() {
    cat <<'EOF'
VMW - VM Workspace

Usage:
  vmw [profile]                Guided step-by-step setup (default vmud)
  vmw menu                     Interactive menu (pick any module)
  vmw setup <profile>          Run the full automated setup (no prompts)
  vmw plan <profile>           Dry-run all modules (print commands)
  vmw deploy <profile>         Generate + define the domain XML
  vmw patch-status             Verify patch integrity + target versions
  vmw patch-check [comp]       Clone sources and verify patches apply cleanly
  vmw status                   Show VMs and profile state
  vmw help                     Show this help
EOF
}

cmd_plan() {
    local profile=$1
    vmw::load_config "$profile" || return 1
    fmtr::box_text "PLAN: $profile"
    vmw::verify_patches
    echo ""
    fmtr::info "The following would be executed for profile '$profile':"
    echo ""
    printf '  %b·%b %s\n' "$TEXT_BRIGHT_GREEN" "$RESET" "Install virt packages (dnsmasq libvirt virt-manager swtpm qemu-base)"
    printf '  %b·%b %s\n' "$TEXT_BRIGHT_GREEN" "$RESET" "Configure user groups + libvirt + vmw-Router network"
    printf '  %b·%b %s\n' "$TEXT_BRIGHT_GREEN" "$RESET" "Clone + patch QEMU ${CFG_PATCHES_QEMU:-<unset>} → /opt/vmw/emulator"
    printf '  %b·%b %s\n' "$TEXT_BRIGHT_GREEN" "$RESET" "Clone + patch EDK2 ${CFG_PATCHES_EDK2:-<unset>} → /opt/vmw/firmware"
    printf '  %b·%b %s\n' "$TEXT_BRIGHT_GREEN" "$RESET" "VFIO passthrough config (IOMMU, vfio-pci)"
    printf '  %b·%b %s\n' "$TEXT_BRIGHT_GREEN" "$RESET" "Kernel build with ${CFG_PATCHES_KERNEL:-<unset>} via linux-tkg (~35GB, -j1)"
    printf '  %b·%b %s\n' "$TEXT_BRIGHT_GREEN" "$RESET" "Generate + define domain XML for $profile (see below)"
    echo ""
    fmtr::info "Generated domain XML (dry-run):"
    vmw::py genxml "$profile"
}

cmd_setup() {
    local profile=$1
    vmw::load_config "$profile" || return 1
    fmtr::box_text "SETUP: $profile"
    vmw::verify_patches || { fmtr::error "Patch verification failed. Run 'vmw patch-status'."; return 1; }
    # Build an undetected VM in dependency order: kernel first so the boot
    # entry exists, then emulator/firmware, then passthrough, then deploy.
    for mod in virtualization kernel qemu edk2 vfio deploy; do
        fmtr::info "[$mod] running..."
        "$VMW_ROOT/modules/$mod.sh" || { fmtr::error "[$mod] failed."; return 1; }
    done
    fmtr::log "Setup complete for profile '$profile'."
}

# Steps that make up the guided build of an undetected VM, in order.
Vmw_GUIDED_STEPS=(
    "virtualization|Install virtualization stack (libvirt, QEMU, swtpm)|Install the libvirt/KVM stack so the VM can run"
    "kernel|Build patched kernel (linux-tkg)|Build and install the patched kernel, then set up its boot entry"
    "qemu|Build patched QEMU|Clone, patch, and build the anti-detection QEMU"
    "edk2|Build patched EDK2/OVMF|Clone, patch, and build the anti-detection UEFI firmware"
    "vfio|Configure GPU passthrough|Set up VFIO/IOMMU and bootloader for a passed-through dGPU"
    "deploy|Deploy VM from profile|Generate the domain XML and define the VM"
)

cmd_guided() {
    local profile=$1
    vmw::load_config "$profile" || return 1

    fmtr::box_text "VMW guided setup: $profile"
    echo ""
    fmtr::info "This will build an undetected VM step by step:"
    local i step label desc
    for i in "${!Vmw_GUIDED_STEPS[@]}"; do
        step="${Vmw_GUIDED_STEPS[$i]}"
        label="${step#*|}"
        desc="${label#*|}"
        label="${label%%|*}"
        printf '  %b%2d.%b %s\n' "$TEXT_BRIGHT_YELLOW" "$((i+1))" "$RESET" "$label"
    done
    echo ""
    prmt::yes_or_no "$(fmtr::ask_inline "Review the plan first (vmw plan $profile)?")" && { cmd_plan "$profile"; }

    if ! vmw::verify_patches; then
        fmtr::error "Patch verification failed. Run 'vmw patch-status' before continuing."
        return 1
    fi

    for i in "${!Vmw_GUIDED_STEPS[@]}"; do
        local step="${Vmw_GUIDED_STEPS[$i]}"
        local mod="${step%%|*}"
        local label="${step#*|}"
        local desc="${label#*|}"
        label="${label%%|*}"

        echo ""
        fmtr::box_text "Step $((i+1))/${#Vmw_GUIDED_STEPS[@]}: $label"
        fmtr::info "$desc"
        echo ""

        if vmw::state has "module.$mod.complete"; then
            fmtr::info "Step already completed in this session's state. Skipping."
        elif vmw::step_ready "$mod"; then
            fmtr::info "Step already set up on this system. Skipping."
        elif prmt::yes_or_no "$(fmtr::ask_inline "Run this step now?")"; then
            if "$VMW_ROOT/modules/$mod.sh"; then
                vmw::step_done "$mod" complete
                fmtr::log "Step $((i+1)) ($label) completed."
            else
                fmtr::error "Step $((i+1)) ($label) failed. See $LOG_FILE"
                prmt::yes_or_no "$(fmtr::ask_inline "Continue to the next step anyway?")" || return 1
            fi
        else
            fmtr::warn "Skipped step $((i+1)) ($label)."
        fi
    done

    echo ""
    fmtr::box_text "Guided setup finished"
    fmtr::info "Next: start the VM with: $ROOT_ESC virsh start '${CFG_NAME:-$profile}'"
}

cmd_deploy() {
    "$VMW_ROOT/modules/deploy.sh" "$@"
}

cmd_patch_status() {
    vmw::py patches verify
}

cmd_patch_check() {
    vmw::py patchcheck "$@"
}

cmd_status() {
    fmtr::box_text "VMW STATUS"
    echo ""
    fmtr::info "Config profiles:"
    for f in "$VMW_ROOT"/configs/*.yml; do
        [[ -e $f ]] || continue
        printf '  %s\n' "$(basename "$f")"
    done
    echo ""
    fmtr::info "Libvirt domains:"
    $ROOT_ESC virsh list --all 2>/dev/null || fmtr::error "Cannot list VMs (libvirt not reachable?)"
    echo ""
    if [[ -f "$VMW_ROOT/.vmw/state.json" ]]; then
        fmtr::info "State manifest:"
        vmw::state list
    fi
}

main_menu() {
    local menu=(
        "Virtualization Setup|virtualization.sh"
        "QEMU (Patched) Setup|qemu.sh"
        "EDK2 (Patched) Setup|edk2.sh"
        "GPU Passthrough Setup|vfio.sh"
        "Kernel (Patched) Setup|kernel.sh"
        "Deploy VM from profile|deploy.sh"
    )

    trap '
        clear & echo
        if prmt::yes_or_no "$(fmtr::ask "Do you want to clear the logs directory?")"; then
            rm -f -- "${LOG_PATH}"/*.log
        fi
        exit 0
    ' INT

    while :; do
        clear
        fmtr::box_text " >> VMW << "; echo ""

        for i in "${!menu[@]}"; do
            printf '  %b[%d]%b %s\n' \
                "$TEXT_BRIGHT_YELLOW" "$((i+1))" "$RESET" "${menu[i]%%|*}"
        done
        echo
        printf '  %b[8]%b Plan (dry-run)\n' "$TEXT_BRIGHT_YELLOW" "$RESET"
        printf '  %b[9]%b Status\n' "$TEXT_BRIGHT_YELLOW" "$RESET"
        echo

        local choice
        choice="$(prmt::quick_prompt '  Enter your choice [1-9]: ')" || continue
        clear

        case "$choice" in
            8) cmd_plan "${CONFIG_PROFILE:-vmud}";;
            9) cmd_status;;
            *)
                if (( choice >= 1 && choice <= ${#menu[@]} )); then
                    local idx=$((choice - 1))
                    local label="${menu[idx]%%|*}"
                    local script="${menu[idx]#*|}"
                    fmtr::box_text "$label"
                    if [[ -n "$script" ]]; then
                        "$VMW_ROOT/modules/$script" "${CONFIG_PROFILE:-vmud}"
                    else
                        fmtr::warn "This module isn't ready yet."
                    fi
                else
                    fmtr::error "Invalid option, please try again."
                fi
                ;;
        esac

        prmt::quick_prompt "$(fmtr::info 'Press any key to continue...')"
    done
}

cmd="${1:-guided}"
case "$cmd" in
    guided) shift; cmd_guided "${1:-vmud}" ;;
    menu) main_menu ;;
    setup) shift; cmd_setup "${1:-vmud}" ;;
    plan) shift; cmd_plan "${1:-vmud}" ;;
    deploy) shift; cmd_deploy "$@" ;;
    patch-status) cmd_patch_status ;;
    patch-check) shift; cmd_patch_check "$@" ;;
    status) cmd_status ;;
    help|-h|--help) usage ;;
    -*) fmtr::error "Unknown option: $cmd"; echo; usage; exit 1 ;;
    *) cmd_guided "$cmd" ;;
esac
